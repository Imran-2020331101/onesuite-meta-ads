<section class="os-usecase-section">
  <div class="os-container">
    <div class="os-header">
      <span class="os-eyebrow">BUILT FOR SERVICE PROVIDERS</span>
      <h2>OneSuite Fits<br /><span>Your Business.</span></h2>
      <p class="os-subtitle">
        Whether you're managing social media, building websites, supporting
        clients or delivering creative projects, your client workflow deserves
        one organised system.
      </p>
    </div>

    <div class="os-grid">
      <!-- Card 1 -->
      <div class="os-usecase-card featured">
        <div class="os-card-top">
          <div class="os-icon">◎</div>
          <div class="os-number">01</div>
        </div>
        <h3>Social Media Managers</h3>
        <p>
          Manage multiple clients, content projects, tasks, contracts, invoices
          and time from one workspace.
        </p>
        <div class="os-checklist">
          <div class="os-check-item">
            <span class="os-check">✓</span> Client management
          </div>
          <div class="os-check-item">
            <span class="os-check">✓</span> Project & task tracking
          </div>
          <div class="os-check-item">
            <span class="os-check">✓</span> Time tracking
          </div>
          <div class="os-check-item">
            <span class="os-check">✓</span> Contracts & invoices
          </div>
        </div>
        <a href="https://app.onesuite.io" class="os-cta"
          >Manage Your Clients &rarr;</a
        >
      </div>

      <!-- Card 2 -->
      <div class="os-usecase-card">
        <div class="os-card-top">
          <div class="os-icon">✦</div>
          <div class="os-number">02</div>
        </div>
        <h3>Freelancers</h3>
        <p>
          Keep your projects, clients, payments and important documents
          organised without building a complicated system yourself.
        </p>
        <div class="os-checklist">
          <div class="os-check-item">
            <span class="os-check">✓</span> Projects
          </div>
          <div class="os-check-item">
            <span class="os-check">✓</span> Time tracking
          </div>
          <div class="os-check-item">
            <span class="os-check">✓</span> Invoicing
          </div>
          <div class="os-check-item">
            <span class="os-check">✓</span> Client management
          </div>
        </div>
        <a href="https://app.onesuite.io" class="os-cta"
          >Simplify Your Workflow &rarr;</a
        >
      </div>

      <!-- Card 3 -->
      <div class="os-usecase-card">
        <div class="os-card-top">
          <div class="os-icon">◇</div>
          <div class="os-number">03</div>
        </div>
        <h3>Virtual Assistants</h3>
        <p>
          Stay organised across clients and recurring tasks while keeping your
          work, time and communication easy to manage.
        </p>
        <div class="os-checklist">
          <div class="os-check-item">
            <span class="os-check">✓</span> Multiple clients
          </div>
          <div class="os-check-item">
            <span class="os-check">✓</span> Tasks & projects
          </div>
          <div class="os-check-item">
            <span class="os-check">✓</span> Time tracking
          </div>
          <div class="os-check-item">
            <span class="os-check">✓</span> Client communication
          </div>
        </div>
        <a href="https://app.onesuite.io" class="os-cta"
          >Organise Your Business &rarr;</a
        >
      </div>

      <!-- Card 4 -->
      <div class="os-usecase-card">
        <div class="os-card-top">
          <div class="os-icon">♢</div>
          <div class="os-number">04</div>
        </div>
        <h3>Wedding & Event Pros</h3>
        <p>
          Keep enquiries, projects, contracts, payments and client communication
          organised throughout every event.
        </p>
        <div class="os-checklist">
          <div class="os-check-item">
            <span class="os-check">✓</span> Client details
          </div>
          <div class="os-check-item">
            <span class="os-check">✓</span> Event projects
          </div>
          <div class="os-check-item">
            <span class="os-check">✓</span> Contracts
          </div>
          <div class="os-check-item">
            <span class="os-check">✓</span> Payments
          </div>
        </div>
        <a href="https://app.onesuite.io" class="os-cta"
          >Organise Every Project &rarr;</a
        >
      </div>
    </div>
  </div>
</section>

<style>
  .os-usecase-section {
    background-color: #ffffff;
    padding: 110px 20px;
    font-family:
      system-ui,
      -apple-system,
      sans-serif;
  }

  .os-container {
    max-width: 1180px;
    margin: 0 auto;
  }

  .os-header {
    text-align: center;
    margin-bottom: 64px;
  }

  .os-eyebrow {
    display: inline-flex;
    padding: 7px 14px;
    border-radius: 999px;
    background-color: #f1f5ff;
    border: 1px solid var(--os-orange);
    color: var(--os-orange);
    /* border: 2px solid #3f7ff5;
    color: #3f7ff5; */
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 24px;
  }

  .os-header h2 {
    font-size: clamp(38px, 5vw, 56px);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1.04;
    color: #101828;
    margin: 0 0 24px 0;
  }

  .os-header h2 span {
    color: #3f7ff5;
  }

  .os-subtitle {
    max-width: 650px;
    margin: 0 auto;
    color: #667085;
    font-size: 17px;
    line-height: 1.7;
  }

  .os-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }

  .os-usecase-card {
    background-color: #85a9ff;
    border: 1px solid #e3e9f2;
    border-radius: 16px;
    padding: 30px 26px;
    display: flex;
    flex-direction: column;
  }

  .os-usecase-card.featured {
    background: linear-gradient(145deg, #85a9ff, #ffffff);
    border-color: #d6e2fa;
  }

  .os-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }

  .os-icon {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: linear-gradient(135deg, #3f7ff5, #2b61cd);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
  }

  .os-number {
    color: #d0d5dd;
    font-size: 24px;
    font-weight: 800;
    font-family: monospace;
  }

  .os-usecase-card h3 {
    font-size: 19px;
    font-weight: 750;
    color: #101828;
    margin: 0 0 12px 0;
  }

  .os-usecase-card p {
    color: #667085;
    font-size: 14px;
    line-height: 1.6;
    margin: 0 0 20px 0;
  }

  .os-checklist {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    border-top: 1px solid #e8edf4;
    padding-top: 16px;
    margin-top: auto;
    margin-bottom: 24px;
  }

  .os-check-item {
    display: flex;
    align-items: center;
    gap: 7px;
    color: #344054;
    font-size: 11px;
    font-weight: 550;
  }

  .os-check {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background-color: #ecfdf3;
    color: #039855;
    font-size: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .os-cta {
    color: #3f7ff5;
    font-weight: 700;
    font-size: 12px;
    text-decoration: none;
    display: inline-block;
    transition: opacity 0.2s;
  }

  .os-cta:hover {
    opacity: 0.8;
  }

  @media (max-width: 700px) {
    .os-usecase-section {
      padding: 80px 20px;
    }
    .os-grid {
      grid-template-columns: 1fr;
    }
    .os-checklist {
      grid-template-columns: 1fr;
    }
  }
</style>

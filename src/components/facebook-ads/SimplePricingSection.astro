<script>
  const grid = document.querySelector(".os7-pricing-grid");
  const planCard = document.querySelector(".os7-plan-card");
  const offerCard = document.querySelector(".os7-offer-card");
  const openBtn = document.getElementById("os7-open-checkout");
  const openOfferBtn = document.getElementById("os7-open-checkout-offer");
  const closeBtn = document.getElementById("os7-close-checkout");
  const panel = document.getElementById("os7-checkout-panel");
  const form = document.getElementById("os7-checkout-form-el");
  const nameInput = document.getElementById("os7-name");
  const emailInput = document.getElementById("os7-email");
  const submitBtn = document.getElementById("os7-checkout-submit");

  const ACTIVE_LEFT = "os7-checkout-active-left";
  const ACTIVE_RIGHT = "os7-checkout-active-right";

  // mode is 'left' (triggered from the plan card), 'right' (triggered from the
  // offer card), or null (closed). Only one of the two active classes is ever
  // set at a time.
  function setActive(mode) {
    if (!grid) return;
    grid.classList.toggle(ACTIVE_LEFT, mode === "left");
    grid.classList.toggle(ACTIVE_RIGHT, mode === "right");
    const active = mode !== null;
    // Keep hidden panels out of the tab order and off the accessibility tree
    // while they're visually hidden by the slide/fade transition.
    if ("inert" in HTMLElement.prototype) {
      if (planCard) planCard.inert = active;
      if (offerCard) offerCard.inert = active;
      if (panel) panel.inert = !active;
    }
  }

  if (panel && "inert" in HTMLElement.prototype) panel.inert = true;

  openBtn?.addEventListener("click", () => setActive("left"));
  openOfferBtn?.addEventListener("click", () => setActive("right"));
  closeBtn?.addEventListener("click", () => setActive(null));

  function updateSubmitState() {
    if (!submitBtn || !nameInput || !emailInput) return;
    const valid =
      nameInput.value.trim().length > 0 &&
      emailInput.validity.valid &&
      emailInput.value.trim().length > 0;
    submitBtn.disabled = !valid;
  }
  nameInput?.addEventListener("input", updateSubmitState);
  emailInput?.addEventListener("input", updateSubmitState);

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (form.checkValidity()) {
      window.location.href = "https://app.onesuite.io";
    }
  });
</script>

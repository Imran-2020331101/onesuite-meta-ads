---
// FacebookAdsFAQ.astro
---

<section class="os9-section" id="onesuite-faq">
  <div class="container">
    <div class="header">
      <div class="eyebrow">FREQUENTLY ASKED QUESTIONS</div>
      <h2>Questions? <span>We've Got Answers.</span></h2>
      <p class="subtitle">
        Everything you need to know about OneSuite, getting started, the White
        Label Package, and your branded client experience.
      </p>
    </div>

    <div class="os9-faq">
      <!-- Item 1 -->
      <div class="os9-item os9-open">
        <button class="os9-question">
          <div class="title-wrap">
            <h3>What is OneSuite?</h3>
          </div>
          <span class="toggle-icon">+</span>
        </button>
        <div class="os9-answer">
          <p>
            OneSuite is a workspace designed for client-based businesses. It
            brings together your client management, project tracking, time
            tracking, contracts, invoices, and reporting into one organised
            platform — so you can manage your work without switching between
            multiple tools.
          </p>
        </div>
      </div>

      <!-- Item 2 -->
      <div class="os9-item">
        <button class="os9-question">
          <div class="title-wrap">
            <h3>Who is OneSuite for?</h3>
          </div>
          <span class="toggle-icon">+</span>
        </button>
        <div class="os9-answer">
          <p>
            OneSuite is built for service providers, freelancers, agencies,
            virtual assistants, consultants, and anyone who works directly with
            clients. Whether you manage social media, run creative projects, or
            offer professional services, OneSuite helps keep your work
            organised.
          </p>
        </div>
      </div>

      <!-- Item 3 -->
      <div class="os9-item">
        <button class="os9-question">
          <div class="title-wrap">
            <h3>How much does OneSuite cost?</h3>
          </div>
          <span class="toggle-icon">+</span>
        </button>
        <div class="os9-answer">
          <p>
            OneSuite is $9 per person per month. This includes everything —
            unlimited clients, unlimited projects, time tracking, contracts,
            invoicing, reporting, and the client portal.
          </p>
        </div>
      </div>

      <!-- Item 4 -->
      <div class="os9-item">
        <button class="os9-question">
          <div class="title-wrap">
            <h3>Is there a free trial?</h3>
          </div>
          <span class="toggle-icon">+</span>
        </button>
        <div class="os9-answer">
          <p>
            Yes. You can start a free trial to explore OneSuite and see how it
            fits your workflow before committing.
          </p>
        </div>
      </div>

      <!-- Item 5 -->
      <div class="os9-item">
        <button class="os9-question">
          <div class="title-wrap">
            <h3>Do I need a credit card to start?</h3>
          </div>
          <span class="toggle-icon">+</span>
        </button>
        <div class="os9-answer">
          <p>No. You can start your trial without entering a credit card.</p>
        </div>
      </div>

      <!-- Item 6 -->
      <div class="os9-item">
        <button class="os9-question">
          <div class="title-wrap">
            <h3>What is the White Label Package?</h3>
          </div>
          <span class="toggle-icon">+</span>
        </button>
        <div class="os9-answer">
          <p>
            The White Label Package lets you brand your OneSuite workspace with
            your own logo, colours, and domain — so your clients see your brand,
            not OneSuite.
          </p>
        </div>
      </div>

      <!-- Item 7 (Highlight) -->
      <div class="os9-item os9-highlight">
        <button class="os9-question">
          <div class="title-wrap">
            <h3>Does the White Label Package include setup help?</h3>
            <span class="badge">WHITE LABEL</span>
          </div>
          <span class="toggle-icon">+</span>
        </button>
        <div class="os9-answer">
          <p>
            Yes. The White Label Package includes personalised setup support
            from a dedicated agent who helps you configure your branding,
            workspace, and client portal.
          </p>
        </div>
      </div>

      <!-- Item 8 (Highlight) -->
      <div class="os9-item os9-highlight">
        <button class="os9-question">
          <div class="title-wrap">
            <h3>Will I have a personal agent to help me?</h3>
            <span class="badge">WHITE LABEL</span>
          </div>
          <span class="toggle-icon">+</span>
        </button>
        <div class="os9-answer">
          <p>
            Yes. When you purchase the White Label Package, you’re assigned a
            personal onboarding agent who walks you through setup, answers
            questions, and helps you launch your branded client experience.
          </p>
        </div>
      </div>

      <!-- Item 9 (Highlight) -->
      <div class="os9-item os9-highlight">
        <button class="os9-question">
          <div class="title-wrap">
            <h3>Is live support included with the White Label Package?</h3>
            <span class="badge">WHITE LABEL</span>
          </div>
          <span class="toggle-icon">+</span>
        </button>
        <div class="os9-answer">
          <p>
            Yes. White Label clients receive priority live support to assist
            with branding, configuration, and ongoing questions about their
            workspace.
          </p>
        </div>
      </div>

      <!-- Item 10 -->
      <div class="os9-item">
        <button class="os9-question">
          <div class="title-wrap">
            <h3>Can I use my own branding?</h3>
          </div>
          <span class="toggle-icon">+</span>
        </button>
        <div class="os9-answer">
          <p>
            Yes. With the White Label Package, you can use your own logo, brand
            colours, and custom domain to create a fully branded experience for
            your clients.
          </p>
        </div>
      </div>

      <!-- Item 11 -->
      <div class="os9-item">
        <button class="os9-question">
          <div class="title-wrap">
            <h3>Can I manage unlimited clients and projects?</h3>
          </div>
          <span class="toggle-icon">+</span>
        </button>
        <div class="os9-answer">
          <p>
            Yes. OneSuite includes unlimited clients and unlimited projects on
            every plan.
          </p>
        </div>
      </div>

      <!-- Item 12 -->
      <div class="os9-item">
        <button class="os9-question">
          <div class="title-wrap">
            <h3>Can I cancel my subscription?</h3>
          </div>
          <span class="toggle-icon">+</span>
        </button>
        <div class="os9-answer">
          <p>
            Yes. You can cancel your OneSuite subscription at any time with no
            cancellation fees or penalties.
          </p>
        </div>
      </div>
    </div>

    <div class="os9-cta">
      <div class="cta-icon">?</div>
      <h3>Still have questions?</h3>
      <p>Start your trial and explore OneSuite for yourself.</p>
      <a href="https://app.onesuite.io" class="btn"
        >Start Your Free Trial &rarr;</a
      >
    </div>
  </div>
</section>

<style>
  .os9-section {
    padding: 110px 20px;
    background-color: #ffffff;
    font-family:
      system-ui,
      -apple-system,
      sans-serif;
  }

  .container {
    max-width: 780px;
    margin: 0 auto;
    width: 100%;
  }

  .header {
    text-align: center;
    margin-bottom: 50px;
  }

  .eyebrow {
    display: inline-flex;
    padding: 7px 14px;
    border-radius: 999px;
    background: #f1f5ff;
    border: 1px solid var(--os-orange);
    color: var(--os-orange);
    /* border: 1px solid #d9e5ff;
    color: #3f7ff5; */
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 24px;
  }

  .header h2 {
    font-size: 36px;
    font-weight: 800;
    color: #101828;
    margin: 0 0 16px 0;
    line-height: 1.2;
  }

  .header h2 span {
    color: #3f7ff5;
  }

  .subtitle {
    font-size: 16px;
    color: #475467;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .os9-item {
    border: 1px solid #e4e7ec;
    border-radius: 12px;
    margin-bottom: 10px;
    overflow: hidden;
    background: #ffffff;
  }

  .os9-highlight {
    background: linear-gradient(100deg, #ffffff, #f8faff);
    border-color: #d6e2fa;
  }

  .os9-question {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 22px;
    background: transparent;
    cursor: pointer;
    border: none;
    text-align: left;
    font-family: inherit;
  }

  .title-wrap {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }

  .os9-question h3 {
    font-size: 15px;
    font-weight: 650;
    color: #101828;
    margin: 0;
  }

  .badge {
    padding: 3px 8px;
    border-radius: 5px;
    background: #eaf2ff;
    color: #3f7ff5;
    font-size: 8px;
    font-weight: 800;
  }

  .toggle-icon {
    width: 26px;
    height: 26px;
    min-width: 26px;
    border-radius: 7px;
    background: #f2f4f7;
    color: #667085;
    font-size: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
    font-weight: 500;
    line-height: 1;
  }

  .os9-open .toggle-icon {
    transform: rotate(45deg);
  }

  .os9-answer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s ease;
  }

  .os9-open .os9-answer {
    grid-template-rows: 1fr;
  }

  .os9-answer p {
    overflow: hidden;
    min-height: 0;
    padding: 0 22px 18px 22px;
    color: #667085;
    font-size: 14px;
    line-height: 1.7;
    margin: 0;
  }

  .os9-cta {
    margin-top: 40px;
    padding: 28px;
    border-radius: 14px;
    background: #f8faff;
    border: 1px solid #e4e7ec;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cta-icon {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: linear-gradient(135deg, #65a7ff, #315fe7);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 20px;
    margin-bottom: 16px;
  }

  .os9-cta h3 {
    font-size: 16px;
    font-weight: 700;
    color: #101828;
    margin: 0 0 8px 0;
  }

  .os9-cta p {
    font-size: 14px;
    color: #475467;
    margin: 0 0 20px 0;
  }

  .btn {
    display: inline-block;
    padding: 12px 24px;
    background-color: #3f7ff5;
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
    border-radius: 8px;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .btn:hover {
    background-color: #2b61cc;
  }

  @media (max-width: 600px) {
    .header h2 {
      font-size: 28px;
    }
  }
</style>

<script>
  document.querySelectorAll(".os9-question").forEach((btn) => {
    btn.addEventListener("click", () => {
      const item = btn.closest(".os9-item");
      const isOpen = item.classList.contains("os9-open");
      document
        .querySelectorAll(".os9-item")
        .forEach((i) => i.classList.remove("os9-open"));
      if (!isOpen) item.classList.add("os9-open");
    });
  });
</script>

---
// StackConsolidationSection.astro
---

<section class="os6-section" id="onesuite-comparison">
  <div class="os6-container">
    <div class="os6-header">
      <div class="os6-eyebrow">WHY ONESUITE</div>
      <h2 class="os6-title">
        Stop Piecing Your Business <span>Together.</span>
      </h2>
      <p class="os6-subtitle">
        You can manage your business across multiple disconnected tools or keep
        the essential parts of your client workflow organised in one workspace.
      </p>
    </div>

    <div class="os6-table">
      <div class="os6-row os6-header-row">
        <div class="os6-col os6-col-1">
          <div class="os6-th-title">What You Need</div>
        </div>
        <div class="os6-col os6-col-2 os6-highlight">
          <div class="os6-th-title">OneSuite</div>
          <div class="os6-th-subtitle">One Organised Workspace</div>
        </div>
        <div class="os6-col os6-col-3">
          <div class="os6-th-title">Multiple Separate Tools</div>
          <div class="os6-th-subtitle">Connected manually</div>
        </div>
      </div>

      <!-- Row 1 -->
      <div class="os6-row">
        <div class="os6-col os6-col-1">
          <span class="os6-icon">◎</span> Client Management
        </div>
        <div class="os6-col os6-col-2 os6-highlight">
          <div class="os6-check">✓</div>
        </div>
        <div class="os6-col os6-col-3"><span class="os6-dot">•</span></div>
      </div>

      <!-- Row 2 -->
      <div class="os6-row">
        <div class="os6-col os6-col-1">
          <span class="os6-icon">▣</span> Project Management
        </div>
        <div class="os6-col os6-col-2 os6-highlight">
          <div class="os6-check">✓</div>
        </div>
        <div class="os6-col os6-col-3"><span class="os6-dot">•</span></div>
      </div>

      <!-- Row 3 -->
      <div class="os6-row">
        <div class="os6-col os6-col-1">
          <span class="os6-icon">◷</span> Time Tracking
        </div>
        <div class="os6-col os6-col-2 os6-highlight">
          <div class="os6-check">✓</div>
        </div>
        <div class="os6-col os6-col-3"><span class="os6-dot">•</span></div>
      </div>

      <!-- Row 4 -->
      <div class="os6-row">
        <div class="os6-col os6-col-1">
          <span class="os6-icon">□</span> Contracts & E-Signatures
        </div>
        <div class="os6-col os6-col-2 os6-highlight">
          <div class="os6-check">✓</div>
        </div>
        <div class="os6-col os6-col-3"><span class="os6-dot">•</span></div>
      </div>

      <!-- Row 5 -->
      <div class="os6-row">
        <div class="os6-col os6-col-1">
          <span class="os6-icon">$</span> Invoicing & Payments
        </div>
        <div class="os6-col os6-col-2 os6-highlight">
          <div class="os6-check">✓</div>
        </div>
        <div class="os6-col os6-col-3"><span class="os6-dot">•</span></div>
      </div>

      <!-- Row 6 -->
      <div class="os6-row">
        <div class="os6-col os6-col-1">
          <span class="os6-icon">↗</span> Reporting & Profitability
        </div>
        <div class="os6-col os6-col-2 os6-highlight">
          <div class="os6-check">✓</div>
        </div>
        <div class="os6-col os6-col-3"><span class="os6-dot">•</span></div>
      </div>

      <!-- Row 7 -->
      <div class="os6-row">
        <div class="os6-col os6-col-1">
          <span class="os6-icon">◇</span> Client Portal
        </div>
        <div class="os6-col os6-col-2 os6-highlight">
          <div class="os6-check">✓</div>
        </div>
        <div class="os6-col os6-col-3"><span class="os6-dot">•</span></div>
      </div>

      <!-- Row 8 -->
      <div class="os6-row">
        <div class="os6-col os6-col-1">
          <span class="os6-icon">↔</span> One Connected Workspace
        </div>
        <div class="os6-col os6-col-2 os6-highlight">
          <span class="os6-text-green">✓ Connected</span>
        </div>
        <div class="os6-col os6-col-3">
          <span class="os6-text-red">× Disconnected</span>
        </div>
      </div>

      <!-- Row 9 -->
      <div class="os6-row">
        <div class="os6-col os6-col-1">
          <span class="os6-icon">⌁</span> Switching Between Platforms
        </div>
        <div class="os6-col os6-col-2 os6-highlight">
          <span class="os6-text-green">✓ Less switching</span>
        </div>
        <div class="os6-col os6-col-3">
          <span class="os6-text-red">× More switching</span>
        </div>
      </div>

      <!-- Row 10 -->
      <div class="os6-row">
        <div class="os6-col os6-col-1">
          <span class="os6-icon">✦</span> Organised Client Experience
        </div>
        <div class="os6-col os6-col-2 os6-highlight">
          <span class="os6-text-green">✓ One workspace</span>
        </div>
        <div class="os6-col os6-col-3">
          <span class="os6-text-red">× Multiple systems</span>
        </div>
      </div>
    </div>

    <div class="os6-bottom">
      <div class="os6-bottom-left">
        <div class="os6-bottom-icon">ϟ</div>
        <div class="os6-bottom-text">
          <h3>One workspace. Less complexity.</h3>
          <p>
            Bring your client management, projects, time, contracts, invoices
            and reporting into one organised system.
          </p>
        </div>
      </div>
      <div class="os6-bottom-right">
        <a href="https://app.onesuite.io" class="os6-bottom-cta"
          >Start Your Free Trial &rarr;</a
        >
      </div>
    </div>

    <div class="os6-trust-strip">
      <span>✓ Unlimited clients</span>
      <span class="os6-bullet">•</span>
      <span>✓ Unlimited projects</span>
      <span class="os6-bullet">•</span>
      <span>✓ $9/person/month</span>
      <span class="os6-bullet">•</span>
      <span>✓ Cancel anytime</span>
    </div>
  </div>
</section>

<style>
  .os6-section {
    padding: 110px 20px;
    background-color: #ffffff;
    font-family:
      system-ui,
      -apple-system,
      sans-serif;
    color: #101828;
  }

  .os6-container {
    max-width: 1100px;
    margin: 0 auto;
    width: min(1100px, calc(100% - 48px));
  }

  .os6-header {
    text-align: center;
    margin-bottom: 60px;
  }

  .os6-eyebrow {
    display: inline-flex;
    padding: 7px 14px;
    border-radius: 999px;
    background: #f1f5ff;
    border: 1px solid var(--os-orange);
    color: var(--os-orange);
    /* border: 1px solid #d9e5ff;
    color: #3F7FF5; */
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.14em;
    margin-bottom: 24px;
    text-transform: uppercase;
  }

  .os6-title {
    font-size: 42px;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 20px 0;
    letter-spacing: -0.02em;
  }

  .os6-title span {
    color: #3f7ff5;
  }

  .os6-subtitle {
    font-size: 18px;
    color: #475467;
    line-height: 1.6;
    max-width: 760px;
    margin: 0 auto;
  }

  .os6-table {
    border-radius: 16px;
    border: 1px solid #e4e7ec;
    overflow: hidden;
    margin-bottom: 40px;
    box-shadow: 0 4px 20px rgba(16, 24, 40, 0.03);
  }

  .os6-row {
    display: grid;
    grid-template-columns: 1.45fr 0.9fr 0.9fr;
    min-height: 62px;
    border-bottom: 1px solid #e4e7ec;
  }

  .os6-row:last-child {
    border-bottom: none;
  }

  .os6-header-row {
    background-color: #f8fafc;
    min-height: 80px;
  }

  .os6-col {
    display: flex;
    align-items: center;
    padding: 16px 24px;
    font-size: 15px;
    font-weight: 500;
  }

  .os6-col-1 {
    color: #101828;
    justify-content: flex-start;
  }

  .os6-col-2,
  .os6-col-3 {
    justify-content: center;
    text-align: center;
  }

  .os6-highlight {
    background: linear-gradient(
      180deg,
      rgba(63, 127, 245, 0.08),
      rgba(63, 127, 245, 0.025)
    );
    border-left: 1px solid #e0e7f3;
    border-right: 1px solid #e0e7f3;
  }

  .os6-header-row .os6-col-1 {
    align-items: flex-end;
    padding-bottom: 20px;
  }

  .os6-header-row .os6-col-2,
  .os6-header-row .os6-col-3 {
    flex-direction: column;
    justify-content: center;
  }

  .os6-th-title {
    font-size: 16px;
    font-weight: 700;
    color: #101828;
    margin-bottom: 4px;
  }

  .os6-th-subtitle {
    font-size: 13px;
    color: #667085;
    font-weight: 400;
  }

  .os6-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    margin-right: 12px;
    color: #667085;
    font-size: 18px;
  }

  .os6-check {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background-color: #eaf2ff;
    color: #3f7ff5;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: bold;
  }

  .os6-dot {
    color: #98a2b3;
    font-size: 24px;
  }

  .os6-text-green {
    color: #039855;
    font-size: 14px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .os6-text-red {
    color: #f04438;
    font-size: 14px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .os6-bottom {
    background: linear-gradient(135deg, #3f7ff5, #2961e0);
    border-radius: 16px;
    padding: 32px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    box-shadow: 0 12px 24px rgba(63, 127, 245, 0.15);
  }

  .os6-bottom-left {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .os6-bottom-icon {
    width: 43px;
    height: 43px;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-size: 24px;
    flex-shrink: 0;
  }

  .os6-bottom-text h3 {
    color: #ffffff;
    font-size: 18px;
    font-weight: 700;
    margin: 0 0 6px 0;
  }

  .os6-bottom-text p {
    color: rgba(255, 255, 255, 0.8);
    font-size: 15px;
    margin: 0;
    max-width: 500px;
    line-height: 1.5;
  }

  .os6-bottom-cta {
    display: inline-block;
    background-color: #ffffff;
    color: #3f7ff5;
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
    padding: 14px 28px;
    border-radius: 10px;
    transition:
      transform 0.2s,
      box-shadow 0.2s;
    white-space: nowrap;
  }

  .os6-bottom-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
  }

  .os6-trust-strip {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    font-size: 11px;
    color: #667085;
    font-weight: 500;
  }

  .os6-bullet {
    color: #e4e7ec;
  }

  @media (max-width: 900px) {
    .os6-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
      padding: 28px;
    }
  }

  @media (max-width: 768px) {
    .os6-section {
      padding: 60px 16px;
    }

    .os6-title {
      font-size: 32px;
    }

    .os6-table {
      border-radius: 12px;
      border-left: none;
      border-right: none;
      box-shadow: none;
    }

    .os6-row {
      display: flex;
      flex-direction: column;
      padding: 16px 0;
      border-bottom: 1px solid #e4e7ec;
    }

    .os6-header-row {
      display: none;
    }

    .os6-col {
      padding: 8px 16px;
      width: 100%;
      justify-content: flex-start;
    }

    .os6-col-1 {
      font-weight: 700;
      font-size: 16px;
      margin-bottom: 8px;
    }

    .os6-col-2,
    .os6-col-3 {
      justify-content: flex-start;
      text-align: left;
    }

    .os6-col-2::before {
      content: "OneSuite: ";
      font-weight: 500;
      color: #667085;
      margin-right: 8px;
      width: 120px;
    }

    .os6-col-3::before {
      content: "Other tools: ";
      font-weight: 500;
      color: #667085;
      margin-right: 8px;
      width: 120px;
    }

    .os6-highlight {
      background: none;
      border-left: none;
      border-right: none;
    }

    .os6-trust-strip {
      flex-wrap: wrap;
      gap: 12px;
    }

    .os6-bullet {
      display: none;
    }
  }
</style>

---
// FacebookAdsHeroSingleColumn — alternate hero layout modeled after a
// Softr-style hero pattern: announcement pill → big centered headline →
// subtext → rounded audience tags → a single large bordered "showcase box"
// with a soft multi-color glow, holding the product screenshot and the
// primary CTA. Same underlying copy as FacebookAdsHero.astro; the benefits
// checklist and floating overlay cards were dropped to keep this format's
// clean, minimal look, and the star rating moved to sit under the tags.
// Not currently imported by any page.
---

<section class="oshsc-hero">
  <div class="oshsc-container">

    <!-- ANNOUNCEMENT PILL -->
    <a href="#branding-offer" class="oshsc-badge-pill">
      <span class="oshsc-badge-chip">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.2 6.8L21 11l-6.8 2.2L12 20l-2.2-6.8L3 11l6.8-2.2L12 2z"/></svg>
        New
      </span>
      <span>Introducing the Branded Client Portal</span>
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"></polyline></svg>
    </a>

    <!-- CONTENT -->
    <div class="oshsc-content">

      <!-- Main headline -->
      <h1>
        No More Messy Systems.
        <span>Stay Organised.<br />Look Professional.</span>
      </h1>

      <!-- Subtext -->
      <p class="oshsc-subtext">
        Keep your clients, projects, and payments organised in one place,
        so you can spend less time managing your business and more time
        serving your clients.
      </p>

      <!-- Audience pills -->
      <div class="oshsc-audiences">
        <span>Client Portal</span>
        <span>Social Media Managers</span>
        <span>Freelancers</span>
        <span>Virtual Assistants</span>
        <span>Wedding &amp; Event Pros</span>
      </div>

      <!-- Social Proof -->
      <div class="oshsc-social-proof">
        <span class="oshsc-stars">★★★★★</span>
        <strong>5/5</strong>
        <span class="oshsc-proof-label">customer rating</span>
        <span class="oshsc-proof-divider"></span>
        <strong>200+</strong>
        <span class="oshsc-proof-label">clients managed</span>
      </div>
    </div>

    <!-- SHOWCASE BOX -->
    <div class="oshsc-showcase-wrap">
      <div class="oshsc-showcase-glow"></div>

      <div class="oshsc-showcase">
        <div class="oshsc-showcase-window">
          <div class="oshsc-window-bar">
            <div class="oshsc-window-dots"><i></i><i></i><i></i></div>
            <div class="oshsc-window-address">app.onesuite.io</div>
            <div class="oshsc-window-profile">MJ</div>
          </div>
          <img
            src="/images/hero/profitibility.png"
            alt="OneSuite Report and Profitibility showing a dashboard with a graph, revenue, expenses, and profit"
            class="oshsc-dashboard-img"
            width="650"
            height="445"
            loading="eager"
          />
        </div>

        <div class="oshsc-showcase-footer">
          <div class="oshsc-showcase-price">
            <strong>$9 <span>/ person / month</span></strong>
            <small>No credit card required · Cancel anytime</small>
          </div>
          <a href="https://app.onesuite.io" class="oshsc-primary">
            Start Your Free Trial
            <span>→</span>
          </a>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  /* ==========================================================
     HERO — SINGLE COLUMN (Softr-style format)
     ========================================================== */
  .oshsc-hero {
    position: relative;
    overflow: hidden;
    padding: 70px 0 90px;
    background:
      radial-gradient(circle, #E4E7EC 1px, transparent 1px),
      #ffffff;
    background-size: 24px 24px;
  }

  .oshsc-container {
    width: min(800px, calc(100% - 40px));
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Announcement pill */
  .oshsc-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 20px 6px 6px;
    border-radius: 999px;
    background: #ffffff;
    border: 1px solid #E4E7EC;
    box-shadow: 0 6px 20px rgba(16,24,40,.07);
    color: #344054;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    transition: box-shadow .2s ease, transform .2s ease;
  }
  .oshsc-badge-pill:hover { box-shadow: 0 8px 24px rgba(16,24,40,.11); transform: translateY(-1px); }
  .oshsc-badge-pill svg:last-child { color: #98A2B3; flex-shrink: 0; }

  .oshsc-badge-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 13px;
    border-radius: 999px;
    background: #101828;
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
  }
  .oshsc-badge-chip svg { color: #F79009; }

  /* CONTENT */
  .oshsc-content {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .oshsc-content h1 {
    max-width: 640px;
    margin: 26px 0 20px;
    color: #101828;
    font-size: clamp(32px, 4.6vw, 48px);
    line-height: 1.15;
    letter-spacing: -.03em;
    font-weight: 750;
  }

  .oshsc-content h1 span { display: block; color: #3F7FF5; }

  .oshsc-subtext {
    max-width: 560px;
    margin: 0;
    color: #475467;
    font-size: 17px;
    line-height: 1.7;
  }

  /* Audience tags — fully rounded chips */
  .oshsc-audiences { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 28px; }
  .oshsc-audiences span {
    padding: 10px 18px;
    border: 1px solid #E4E7EC;
    border-radius: 999px;
    background: #ffffff;
    box-shadow: 0 2px 8px rgba(16,24,40,.04);
    color: #344054;
    font-size: 13px;
    font-weight: 600;
  }

  /* Social proof */
  .oshsc-social-proof {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 22px;
    color: #475467;
    font-size: 13px;
    font-weight: 550;
  }
  .oshsc-stars { color: #F5A623; font-size: 13px; letter-spacing: 1px; }
  .oshsc-social-proof strong { color: #101828; font-weight: 800; }
  .oshsc-proof-label { color: #98A2B3; font-weight: 500; }
  .oshsc-proof-divider { width: 1px; height: 14px; background: #E4E7EC; margin: 0 3px; }

  /* ==========================================================
     SHOWCASE BOX
     ========================================================== */
  .oshsc-showcase-wrap {
    position: relative;
    width: 100%;
    max-width: 720px;
    margin: 50px auto 0;
  }

  .oshsc-showcase-glow {
    position: absolute;
    inset: -50px;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 12% 15%, rgba(247,144,9,.22), transparent 45%),
      radial-gradient(circle at 88% 10%, rgba(63,127,245,.25), transparent 45%),
      radial-gradient(circle at 50% 105%, rgba(238,70,188,.18), transparent 50%);
    filter: blur(45px);
    animation: oshscGlowPulse 6s ease-in-out infinite;
  }
  @keyframes oshscGlowPulse {
    0%,100% { opacity: .8; }
    50% { opacity: 1; }
  }

  .oshsc-showcase {
    position: relative;
    z-index: 1;
    background: #ffffff;
    border: 1px solid #E4E7EC;
    border-radius: 22px;
    box-shadow: 0 30px 70px rgba(16,24,40,.12);
    padding: 14px 14px 0;
  }

  .oshsc-showcase-window {
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid #E4E7EC;
  }

  .oshsc-window-bar { height: 42px; display: flex; align-items: center; gap: 13px; padding: 0 12px; border-bottom: 1px solid #E8ECF2; background: #F8FAFC; }
  .oshsc-window-dots { display: flex; gap: 4px; }
  .oshsc-window-dots i { width: 7px; height: 7px; border-radius: 50%; background: #D0D5DD; font-style: normal; }
  .oshsc-window-address { flex: 1; padding: 5px 10px; border: 1px solid #E4E7EC; border-radius: 5px; background: white; color: #98A2B3; text-align: center; font-size: 8px; }
  .oshsc-window-profile { width: 25px; height: 25px; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: white; background: #3F7FF5; font-size: 8px; font-weight: 800; }

  .oshsc-dashboard-img { display: block; width: 100%; height: auto; }

  .oshsc-showcase-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding: 18px 10px 20px;
  }

  .oshsc-showcase-price { text-align: left; }
  .oshsc-showcase-price strong { display: block; color: #101828; font-size: 15px; font-weight: 800; }
  .oshsc-showcase-price strong span { color: #667085; font-size: 12px; font-weight: 500; }
  .oshsc-showcase-price small { display: block; margin-top: 2px; color: #98A2B3; font-size: 11px; }

  .oshsc-primary {
    min-height: 46px;
    display: inline-flex; align-items: center; justify-content: center; gap: 12px;
    padding: 0 22px;
    border-radius: 9px;
    color: #ffffff; background: #3F7FF5;
    box-shadow: 0 8px 20px rgba(63,127,245,.25);
    font-size: 14px; font-weight: 750;
    text-decoration: none;
    white-space: nowrap;
    transition: all .2s ease;
  }
  .oshsc-primary:hover { color: #ffffff; background: #2867D8; transform: translateY(-2px); }
  .oshsc-primary span { font-size: 17px; }

  /* RESPONSIVE */
  @media (max-width: 700px) {
    .oshsc-hero { padding: 50px 0 65px; }
    .oshsc-container { width: calc(100% - 28px); }
    .oshsc-badge-pill { font-size: 13px; padding: 5px 16px 5px 5px; }
    .oshsc-content h1 { font-size: 30px; }
    .oshsc-subtext { font-size: 16px; }
    .oshsc-audiences span { padding: 8px 14px; font-size: 12px; }
    .oshsc-showcase-wrap { margin-top: 38px; }
    .oshsc-showcase-footer { flex-direction: column; align-items: stretch; text-align: center; }
    .oshsc-showcase-price { text-align: center; }
    .oshsc-primary { width: 100%; }
  }
</style>

---
// GettingStartedSteps.astro
---

<section class="os-getting-started">
  <div class="container">
    <div class="header">
      <div class="eyebrow">GET STARTED IN MINUTES</div>
      <h2>Three Simple Steps <span>to Get Organised.</span></h2>
      <p class="subtitle">Getting started with OneSuite is quick and easy.</p>
    </div>

    <div class="steps-row">
      <div class="step">
        <div class="step-num">1</div>
        <h3>Sign Up</h3>
        <p>
          Create your free account in under a minute. No credit card needed.
        </p>
      </div>

      <div class="step">
        <div class="step-num">2</div>
        <h3>Set Up Your Workspace</h3>
        <p>Add your clients, create projects, and customise your workflow.</p>
      </div>

      <div class="step">
        <div class="step-num">3</div>
        <h3>Start Managing</h3>
        <p>
          Track time, send invoices, and deliver a professional client
          experience.
        </p>
      </div>
    </div>

    <div class="bottom-cta">
      <a href="https://app.onesuite.io" class="btn"
        >Start Your Free Trial &rarr;</a
      >
      <p class="small-text">No credit card required</p>
    </div>
  </div>
</section>

<style>
  .os-getting-started {
    padding: 80px 20px;
    background-color: #ffffff;
    font-family:
      system-ui,
      -apple-system,
      sans-serif;
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
    width: 100%;
  }

  .header {
    margin-bottom: 50px;
  }

  .eyebrow {
    display: inline-flex;
    padding: 7px 14px;
    border-radius: 999px;
    background: #f1f5ff;
    border: 1px solid var(--os-orange);
    color: var(--os-orange);
    /* border: 1px solid #d9e5ff;
    color: #3f7ff5; */
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 24px;
  }

  .header h2 {
    font-size: 36px;
    font-weight: 800;
    color: #101828;
    margin: 0 0 16px 0;
    line-height: 1.2;
  }

  .header h2 span {
    color: #3f7ff5;
  }

  .subtitle {
    font-size: 16px;
    color: #475467;
    margin: 0;
  }

  .steps-row {
    display: flex;
    justify-content: center;
    gap: 32px;
    margin-top: 40px;
  }

  .step {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 32px 24px;
    flex: 1;
    background: #ffffff;
  }

  .step-num {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: linear-gradient(135deg, #65a7ff, #315fe7);
    color: #ffffff;
    font-size: 16px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .step h3 {
    font-size: 18px;
    font-weight: 750;
    color: #101828;
    margin: 16px 0 10px 0;
  }

  .step p {
    font-size: 14px;
    color: #667085;
    line-height: 1.6;
    max-width: 260px;
    margin: 0;
  }

  .bottom-cta {
    margin-top: 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .btn {
    display: inline-block;
    padding: 14px 28px;
    background-color: #3f7ff5;
    color: #ffffff;
    font-size: 16px;
    font-weight: 600;
    border-radius: 8px;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .btn:hover {
    background-color: #2b61cc;
  }

  .small-text {
    font-size: 11px;
    color: #98a2b3;
    margin-top: 8px;
  }

  @media (max-width: 768px) {
    .steps-row {
      flex-direction: column;
      gap: 20px;
    }

    .header h2 {
      font-size: 28px;
    }
  }
</style>

---
// EverythingIncludedSection.astro
---

<section id="onesuite-interactive-features" class="os3-section">
  <div class="os3-container">
    <div class="os3-header">
      <div class="os3-eyebrow">MEET YOUR NEW WORKSPACE</div>
      <h2>Everything You Need.<br /><span>One Workspace.</span></h2>
      <p class="os3-subtitle">
        Stop switching between different tools. OneSuite brings your clients,
        projects, time, contracts, invoices and reporting together in one
        organised workspace.
      </p>
    </div>

    <div class="os3-showcase">
      <div class="os3-tabs">
        <div class="os3-tabs-heading">EVERYTHING IN ONE PLACE</div>

        <div class="os3-tab os3-active" data-tab="clients">
          <div class="os3-tab-icon">◎</div>
          <div class="os3-tab-content">
            <h4>Clients & CRM</h4>
            <p>Keep every client organised.</p>
            <div class="os3-progress"><i style="width: 100%;"></i></div>
          </div>
        </div>

        <div class="os3-tab" data-tab="projects">
          <div class="os3-tab-icon">▦</div>
          <div class="os3-tab-content">
            <h4>Projects & Tasks</h4>
            <p>Know exactly what needs to happen.</p>
            <div class="os3-progress"><i></i></div>
          </div>
        </div>

        <div class="os3-tab" data-tab="time">
          <div class="os3-tab-icon">◷</div>
          <div class="os3-tab-content">
            <h4>Time Tracking</h4>
            <p>See where your time goes.</p>
            <div class="os3-progress"><i></i></div>
          </div>
        </div>

        <div class="os3-tab" data-tab="contracts">
          <div class="os3-tab-icon">□</div>
          <div class="os3-tab-content">
            <h4>Contracts & E-Signatures</h4>
            <p>Send and sign documents easily.</p>
            <div class="os3-progress"><i></i></div>
          </div>
        </div>

        <div class="os3-tab" data-tab="invoices">
          <div class="os3-tab-icon">$</div>
          <div class="os3-tab-content">
            <h4>Invoices & Payments</h4>
            <p>Invoice clients and get paid.</p>
            <div class="os3-progress"><i></i></div>
          </div>
        </div>

        <div class="os3-tab" data-tab="reports">
          <div class="os3-tab-icon">↗</div>
          <div class="os3-tab-content">
            <h4>Reports & Profitability</h4>
            <p>Understand your business.</p>
            <div class="os3-progress"><i></i></div>
          </div>
        </div>
      </div>

      <div class="os3-interface-area">
        <!-- Screen 1: Clients -->
        <div class="os3-screen os3-active-screen" id="screen-clients">
          <img
            src="/images/product/clients-portal-view.webp"
            alt="OneSuite branded client portal showing action required items, tasks, quick links and contact info"
            class="os3-screen-image"
            width="2000"
            height="1138"
            loading="eager"
          />
        </div>

        <!-- Screen 2: Projects -->
        <div class="os3-screen" id="screen-projects">
          <img
            src="/images/product/projects-grid.png"
            alt="OneSuite projects grid showing 97 projects with client avatars, progress and priority"
            class="os3-screen-image"
            width="1366"
            height="768"
            loading="eager"
          />
        </div>

        <!-- Screen 3: Time -->
        <div class="os3-screen os3-time-screen" id="screen-time">
          <div class="os3-time-visual">
            <img
              src="/images/product/time-tracking-weekly.png"
              alt="OneSuite weekly timesheet showing hours logged per project across the week"
              class="os3-screen-image"
              width="1108"
              height="469"
              loading="eager"
            />
            <img
              src="/images/product/time-tracking-timer.png"
              alt="OneSuite running timer card showing live elapsed time for a project"
              class="os3-float-timer"
              width="404"
              height="175"
              loading="eager"
            />
            <img
              src="/images/product/time-tracking-utilization.png"
              alt="OneSuite team member utilization card showing billable hours and weekly capacity"
              class="os3-float-utilization"
              width="273"
              height="446"
              loading="eager"
            />
          </div>
        </div>

        <!-- Screen 4: Contracts -->
        <div class="os3-screen" id="screen-contracts">
          <img
            src="/images/product/contracts-template-library.png"
            alt="OneSuite template library showing freelancer, web development, video editing, SEO and other contract templates"
            class="os3-screen-image"
            width="1440"
            height="808"
            loading="eager"
          />
        </div>

        <!-- Screen 5: Invoices -->
        <div class="os3-screen" id="screen-invoices">
          <div class="os3-invoices-visual">
            <img
              src="/images/product/invoices-overview-strip.png"
              alt="OneSuite invoices overview showing total open and paid amounts and invoices issued by month"
              class="os3-screen-image os3-invoices-top"
              width="908"
              height="246"
              loading="eager"
            />
            <div class="os3-invoices-bottom">
              <img
                src="/images/product/invoices-doc-detail.png"
                alt="A real OneSuite invoice document showing line items, subtotal, tax and amount due"
                class="os3-screen-image os3-invoices-doc-detail"
                width="624"
                height="528"
                loading="eager"
              />
              <img
                src="/images/product/invoices-payments-panel.png"
                alt="OneSuite invoice payment settings panel showing Stripe, PayPal and other payment gateways"
                class="os3-screen-image os3-invoices-payments"
                width="266"
                height="528"
                loading="eager"
              />
            </div>
          </div>
        </div>

        <!-- Screen 6: Reports -->
        <div class="os3-screen" id="screen-reports">
          <img
            src="/images/product/reports-profitability.png"
            alt="OneSuite profitability report showing company profit over the quarter and per-client revenue and profit"
            class="os3-screen-image"
            width="936"
            height="568"
            loading="eager"
          />
        </div>
      </div>
    </div>

    <div class="os3-benefits">
      <div class="os3-benefit-item">
        <span class="os3-check">&check;</span> Unlimited clients
      </div>
      <div class="os3-benefit-item">
        <span class="os3-check">&check;</span> Unlimited projects
      </div>
      <div class="os3-benefit-item">
        <span class="os3-check">&check;</span> Track your time
      </div>
      <div class="os3-benefit-item">
        <span class="os3-check">&check;</span> Invoice & get paid
      </div>
      <div class="os3-benefit-item">
        <span class="os3-check">&check;</span> Understand profitability
      </div>
    </div>
  </div>
</section>

<style>
  .os3-section {
    padding: 110px 20px;
    background: #f8faff;
    font-family:
      system-ui,
      -apple-system,
      sans-serif;
  }
  .os3-container {
    width: min(1200px, calc(100% - 48px));
    margin: 0 auto;
  }
  .os3-header {
    text-align: center;
    margin-bottom: 60px;
  }
  .os3-eyebrow {
    display: inline-flex;
    padding: 7px 14px;
    border-radius: 999px;
    background: #f1f5ff;
    border: 1px solid var(--os-orange);
    color: var(--os-orange);
    /* border: 1px solid #d9e5ff;
    color: #3F7FF5; */
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 24px;
  }
  .os3-header h2 {
    font-size: 42px;
    font-weight: 800;
    color: #101828;
    line-height: 1.1;
    margin: 0 0 16px;
  }
  .os3-header h2 span {
    color: #3f7ff5;
  }
  .os3-subtitle {
    font-size: 18px;
    color: #475467;
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.5;
  }

  .os3-showcase {
    display: grid;
    grid-template-columns: 310px minmax(0, 1fr);
    min-height: 600px;
    border-radius: 24px;
    border: 1px solid #e1e8f2;
    background: #fff;
    box-shadow: 0 25px 70px rgba(16, 24, 40, 0.08);
    overflow: hidden;
  }

  .os3-tabs {
    background: #f7f9fc;
    border-right: 1px solid #e8ecf2;
    padding: 28px 0;
  }
  .os3-tabs-heading {
    padding: 0 22px;
    margin-bottom: 18px;
    color: #98a2b3;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.1em;
  }
  .os3-tab {
    padding: 13px 22px;
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    transition: 0.2s;
    position: relative;
  }
  .os3-tab-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    background: #eef1f5;
    color: #667085;
    transition: 0.2s;
    flex-shrink: 0;
  }
  .os3-tab-content h4 {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    color: #101828;
    transition: 0.2s;
  }
  .os3-tab-content p {
    margin: 2px 0 0;
    font-size: 10px;
    color: #98a2b3;
    transition: 0.2s;
  }
  .os3-progress {
    height: 2px;
    background: #eef1f5;
    margin-top: 8px;
    border-radius: 2px;
    overflow: hidden;
    opacity: 0;
    transition: 0.2s;
  }
  .os3-progress i {
    display: block;
    height: 100%;
    background: #3f7ff5;
    width: 0%;
  }

  .os3-tab.os3-active {
    background: transparent;
  }
  .os3-tab.os3-active .os3-tab-icon {
    background: linear-gradient(135deg, #65a7ff, #315fe7);
    color: #fff;
    box-shadow: 0 4px 12px rgba(63, 127, 245, 0.2);
  }
  .os3-tab.os3-active .os3-progress {
    opacity: 1;
  }
  .os3-tab.os3-active .os3-tab-content h4 {
    color: #3f7ff5;
  }

  .os3-interface-area {
    padding: 30px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    background: #fff;
  }
  .os3-screen {
    display: none;
    flex: 1;
    animation: fadeIn 0.4s ease-out;
  }
  .os3-screen.os3-active-screen {
    display: block;
  }
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .os3-screen-image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid #e4e7ec;
    box-shadow: 0 4px 16px rgba(16, 24, 40, 0.05);
  }

  .os3-time-screen.os3-active-screen {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .os3-time-visual {
    position: relative;
  }
  .os3-float-timer,
  .os3-float-utilization {
    position: absolute;
    display: block;
    width: auto;
    height: auto;
    border-radius: 12px;
    border: 1px solid #e4e7ec;
    box-shadow: 0 14px 32px rgba(16, 24, 40, 0.16);
    background: #fff;
  }
  .os3-float-timer {
    top: -22px;
    right: -18px;
    width: 200px;
    animation: os3FloatTimer 4.5s ease-in-out infinite;
  }
  .os3-float-utilization {
    bottom: -24px;
    left: -18px;
    width: 130px;
    animation: os3FloatUtilization 5.2s ease-in-out infinite;
  }
  @keyframes os3FloatTimer {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }
  @keyframes os3FloatUtilization {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  .os3-invoices-visual {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .os3-invoices-bottom {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }
  .os3-invoices-doc-detail {
    flex: 624 1 0%;
    min-width: 0;
  }
  .os3-invoices-payments {
    flex: 266 1 0%;
    min-width: 0;
  }

  .os3-benefits {
    display: flex;
    justify-content: center;
    gap: 24px;
    margin-top: 40px;
    flex-wrap: wrap;
  }
  .os3-benefit-item {
    font-size: 12px;
    color: #344054;
    font-weight: 550;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .os3-check {
    color: #12b76a;
    font-weight: bold;
  }

  @media (max-width: 980px) {
    .os3-showcase {
      grid-template-columns: 1fr;
    }
    .os3-tabs {
      border-right: none;
      border-bottom: 1px solid #e8ecf2;
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      padding: 16px;
      gap: 16px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .os3-tabs::-webkit-scrollbar {
      display: none;
    }
    .os3-tabs-heading {
      display: none;
    }
    .os3-tab {
      padding: 10px;
      min-width: max-content;
      flex-direction: column;
      gap: 8px;
      text-align: center;
    }
    .os3-tab-content p {
      display: none;
    }
    .os3-progress {
      display: none;
    }
    .os3-float-timer {
      width: 110px;
      top: -10px;
      right: -6px;
    }
    .os3-float-utilization {
      width: 70px;
      bottom: -10px;
      left: -6px;
    }
  }

  @media (max-width: 560px) {
    .os3-invoices-bottom {
      flex-direction: column;
    }
    .os3-invoices-doc-detail,
    .os3-invoices-payments {
      flex: none;
      width: 100%;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const tabs = document.querySelectorAll(".os3-tab");
    const screens = document.querySelectorAll(".os3-screen");
    let currentIndex = 0;
    let autoplayInterval;
    let progressAnimation;
    const AUTOPLAY_DURATION = 4500; // 4.5s
    const IDLE_DURATION = 10000; // 10s
    let idleTimeout;

    function switchTab(index, animate = true) {
      tabs.forEach((t) => {
        t.classList.remove("os3-active");
        const progress = t.querySelector(".os3-progress i");
        if (progress) {
          progress.style.transition = "none";
          progress.style.width = "0%";
        }
      });
      screens.forEach((s) => s.classList.remove("os3-active-screen"));

      currentIndex = index;
      const tab = tabs[currentIndex];
      tab.classList.add("os3-active");
      const tabId = tab.getAttribute("data-tab");
      const targetScreen = document.getElementById(`screen-${tabId}`);
      if (targetScreen) targetScreen.classList.add("os3-active-screen");

      if (animate) {
        const activeProgress = tab.querySelector(".os3-progress i");
        if (activeProgress) {
          // Force reflow
          void activeProgress.offsetWidth;
          activeProgress.style.transition = `width ${AUTOPLAY_DURATION}ms linear`;
          activeProgress.style.width = "100%";
        }
      } else {
        const activeProgress = tab.querySelector(".os3-progress i");
        if (activeProgress) {
          activeProgress.style.transition = "none";
          activeProgress.style.width = "100%";
        }
      }
    }

    function startAutoplay() {
      clearInterval(autoplayInterval);
      switchTab(currentIndex, true);
      autoplayInterval = setInterval(() => {
        let nextIndex = (currentIndex + 1) % tabs.length;
        switchTab(nextIndex, true);
      }, AUTOPLAY_DURATION);
    }

    function resetIdleTimer() {
      clearTimeout(idleTimeout);
      clearInterval(autoplayInterval);

      // Complete progress of current tab instantly since user clicked
      tabs.forEach((t) => {
        const progress = t.querySelector(".os3-progress i");
        if (progress) {
          progress.style.transition = "none";
        }
      });

      idleTimeout = setTimeout(() => {
        startAutoplay();
      }, IDLE_DURATION);
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => {
        switchTab(index, false); // No animation on manual click
        resetIdleTimer();
      });
    });

    // Initialize
    startAutoplay();
  });
</script>

---
// EverythingIncludedSection.astro
---
<section id="onesuite-interactive-features" class="os3-section">
  <div class="os3-container">
    <div class="os3-header">
      <div class="os3-eyebrow">MEET YOUR NEW WORKSPACE</div>
      <h2>Everything You Need.<br><span>One Workspace.</span></h2>
      <p class="os3-subtitle">
        Stop switching between different tools. OneSuite brings your clients, projects, time, contracts, invoices and reporting together in one organised workspace.
      </p>
    </div>

    <div class="os3-showcase">
      <div class="os3-tabs">
        <div class="os3-tabs-heading">EVERYTHING IN ONE PLACE</div>
        
        <div class="os3-tab os3-active" data-tab="clients">
          <div class="os3-tab-icon">◎</div>
          <div class="os3-tab-content">
            <h4>Clients & CRM</h4>
            <p>Keep every client organised.</p>
            <div class="os3-progress"><i style="width: 100%;"></i></div>
          </div>
        </div>

        <div class="os3-tab" data-tab="projects">
          <div class="os3-tab-icon">▦</div>
          <div class="os3-tab-content">
            <h4>Projects & Tasks</h4>
            <p>Know exactly what needs to happen.</p>
            <div class="os3-progress"><i></i></div>
          </div>
        </div>

        <div class="os3-tab" data-tab="time">
          <div class="os3-tab-icon">◷</div>
          <div class="os3-tab-content">
            <h4>Time Tracking</h4>
            <p>See where your time goes.</p>
            <div class="os3-progress"><i></i></div>
          </div>
        </div>

        <div class="os3-tab" data-tab="contracts">
          <div class="os3-tab-icon">□</div>
          <div class="os3-tab-content">
            <h4>Contracts & E-Signatures</h4>
            <p>Send and sign documents easily.</p>
            <div class="os3-progress"><i></i></div>
          </div>
        </div>

        <div class="os3-tab" data-tab="invoices">
          <div class="os3-tab-icon">$</div>
          <div class="os3-tab-content">
            <h4>Invoices & Payments</h4>
            <p>Invoice clients and get paid.</p>
            <div class="os3-progress"><i></i></div>
          </div>
        </div>

        <div class="os3-tab" data-tab="reports">
          <div class="os3-tab-icon">↗</div>
          <div class="os3-tab-content">
            <h4>Reports & Profitability</h4>
            <p>Understand your business.</p>
            <div class="os3-progress"><i></i></div>
          </div>
        </div>
      </div>

      <div class="os3-interface-area">
        <!-- Screen 1: Clients -->
        <div class="os3-screen os3-active-screen" id="screen-clients">
          <div class="os3-screen-header">
            <div class="os3-search-bar">⌕ Search clients...</div>
            <a href="https://app.onesuite.io" class="os3-btn">+ Add Client</a>
          </div>
          <div class="os3-table-wrapper">
            <table class="os3-table">
              <tbody>
                <tr>
                  <td><div class="os3-avatar" style="background: #e0f2fe; color: #0284c7;">SC</div></td>
                  <td class="os3-name">Sarah Creative</td>
                  <td class="os3-val">$1,250</td>
                  <td><span class="os3-badge os3-badge-green">Active</span></td>
                </tr>
                <tr>
                  <td><div class="os3-avatar" style="background: #f3e8ff; color: #7e22ce;">JE</div></td>
                  <td class="os3-name">James & Emma</td>
                  <td class="os3-val">$2,400</td>
                  <td><span class="os3-badge os3-badge-blue">In Progress</span></td>
                </tr>
                <tr>
                  <td><div class="os3-avatar" style="background: #dcfce7; color: #166534;">AS</div></td>
                  <td class="os3-name">Acme Studio</td>
                  <td class="os3-val">$3,200</td>
                  <td><span class="os3-badge os3-badge-green">Active</span></td>
                </tr>
                <tr>
                  <td><div class="os3-avatar" style="background: #ffedd5; color: #c2410c;">MM</div></td>
                  <td class="os3-name">Martin Media</td>
                  <td class="os3-val">$850</td>
                  <td><span class="os3-badge os3-badge-yellow">Pending</span></td>
                </tr>
              </tbody>
            </table>
          </div>
          <div class="os3-screen-footer">28 active clients | View all clients &rarr;</div>
        </div>

        <!-- Screen 2: Projects -->
        <div class="os3-screen" id="screen-projects">
          <div class="os3-screen-header">
            <h3>Active Projects</h3>
            <a href="https://app.onesuite.io" class="os3-btn">+ New Project</a>
          </div>
          <div class="os3-grid-2x2">
            <div class="os3-card">
              <div class="os3-card-top">
                <span class="os3-card-client">Sarah Creative</span>
                <span class="os3-card-due">Due Friday</span>
              </div>
              <h4 class="os3-card-title">Social Media Management</h4>
              <div class="os3-card-progress">
                <div class="os3-progress-bar"><div class="os3-progress-fill" style="width: 78%; background: #3F7FF5;"></div></div>
                <span class="os3-progress-text">78%</span>
              </div>
            </div>
            <div class="os3-card">
              <div class="os3-card-top">
                <span class="os3-card-client">James & Emma</span>
                <span class="os3-card-due">Due Oct 18</span>
              </div>
              <h4 class="os3-card-title">Wedding Video</h4>
              <div class="os3-card-progress">
                <div class="os3-progress-bar"><div class="os3-progress-fill" style="width: 62%; background: #7F56D9;"></div></div>
                <span class="os3-progress-text">62%</span>
              </div>
            </div>
            <div class="os3-card">
              <div class="os3-card-top">
                <span class="os3-card-client">Acme Studio</span>
                <span class="os3-card-due">Due Oct 24</span>
              </div>
              <h4 class="os3-card-title">Website Redesign</h4>
              <div class="os3-card-progress">
                <div class="os3-progress-bar"><div class="os3-progress-fill" style="width: 42%; background: #12B76A;"></div></div>
                <span class="os3-progress-text">42%</span>
              </div>
            </div>
            <div class="os3-card">
              <div class="os3-card-top">
                <span class="os3-card-client">Martin Media</span>
                <span class="os3-card-due">Due Nov 02</span>
              </div>
              <h4 class="os3-card-title">Brand Strategy</h4>
              <div class="os3-card-progress">
                <div class="os3-progress-bar"><div class="os3-progress-fill" style="width: 34%; background: #F79009;"></div></div>
                <span class="os3-progress-text">34%</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Screen 3: Time -->
        <div class="os3-screen" id="screen-time">
          <div class="os3-screen-header">
            <h3>Time Overview</h3>
            <a href="https://app.onesuite.io" class="os3-btn os3-btn-start">&#9654; Start Timer</a>
          </div>
          <div class="os3-stat-cards">
            <div class="os3-stat">
              <span class="os3-stat-label">This Week</span>
              <span class="os3-stat-val">32h 48m</span>
              <span class="os3-stat-change os3-green">+12%</span>
            </div>
            <div class="os3-stat">
              <span class="os3-stat-label">Billable</span>
              <span class="os3-stat-val">27h 20m</span>
              <span class="os3-stat-sub">(83%)</span>
            </div>
            <div class="os3-stat">
              <span class="os3-stat-label">Value</span>
              <span class="os3-stat-val">$1,640</span>
            </div>
          </div>
          <div class="os3-table-wrapper" style="margin-top:20px;">
            <table class="os3-table os3-time-table">
              <tbody>
                <tr>
                  <td>Brand Strategy</td>
                  <td>Martin Media</td>
                  <td>2h 15m</td>
                  <td>Today</td>
                </tr>
                <tr>
                  <td>Website Design</td>
                  <td>Acme Studio</td>
                  <td>4h 30m</td>
                  <td>Yesterday</td>
                </tr>
                <tr>
                  <td>Social Posts</td>
                  <td>Sarah Creative</td>
                  <td>1h 45m</td>
                  <td>Yesterday</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Screen 4: Contracts -->
        <div class="os3-screen" id="screen-contracts">
          <div class="os3-screen-header">
            <h3>Recent Documents</h3>
            <a href="https://app.onesuite.io" class="os3-btn">+ New Contract</a>
          </div>
          <div class="os3-doc-list">
            <div class="os3-doc-item">
              <div class="os3-doc-icon">📄</div>
              <div class="os3-doc-info">
                <h4>Service Agreement</h4>
                <p>Sarah Creative</p>
              </div>
              <span class="os3-badge os3-badge-green">Signed</span>
            </div>
            <div class="os3-doc-item">
              <div class="os3-doc-icon">📄</div>
              <div class="os3-doc-info">
                <h4>Project Contract</h4>
                <p>James & Emma</p>
              </div>
              <span class="os3-badge os3-badge-yellow">Awaiting Signature</span>
            </div>
            <div class="os3-doc-item">
              <div class="os3-doc-icon">📄</div>
              <div class="os3-doc-info">
                <h4>Freelance Agreement</h4>
                <p>Acme Studio</p>
              </div>
              <span class="os3-badge os3-badge-blue">Sent</span>
            </div>
          </div>
          <div class="os3-notification-card">
            <div class="os3-notif-icon">&check;</div>
            <div class="os3-notif-text">
              <strong>Contract signed</strong>
              <p>James & Emma completed their agreement. Just now</p>
            </div>
          </div>
        </div>

        <!-- Screen 5: Invoices -->
        <div class="os3-screen" id="screen-invoices">
          <div class="os3-screen-header">
            <h3>Invoicing</h3>
            <a href="https://app.onesuite.io" class="os3-btn">+ Create Invoice</a>
          </div>
          <div class="os3-stat-cards">
            <div class="os3-stat">
              <span class="os3-stat-label">Outstanding</span>
              <span class="os3-stat-val" style="color: #3F7FF5;">$3,420</span>
            </div>
            <div class="os3-stat">
              <span class="os3-stat-label">Paid This Month</span>
              <span class="os3-stat-val" style="color: #12B76A;">$8,420</span>
            </div>
            <div class="os3-stat">
              <span class="os3-stat-label">Overdue</span>
              <span class="os3-stat-val" style="color: #F04438;">$420</span>
            </div>
          </div>
          <div class="os3-table-wrapper" style="margin-top:20px;">
            <table class="os3-table">
              <tbody>
                <tr>
                  <td><strong>#INV-1051</strong></td>
                  <td>Sarah Creative</td>
                  <td>$1,250</td>
                  <td><span class="os3-badge os3-badge-green">Paid</span></td>
                </tr>
                <tr>
                  <td><strong>#INV-1050</strong></td>
                  <td>Acme Studio</td>
                  <td>$3,200</td>
                  <td><span class="os3-badge os3-badge-blue">Sent</span></td>
                </tr>
                <tr>
                  <td><strong>#INV-1049</strong></td>
                  <td>Martin Media</td>
                  <td>$420</td>
                  <td><span class="os3-badge os3-badge-red">Overdue</span></td>
                </tr>
                <tr>
                  <td><strong>#INV-1048</strong></td>
                  <td>James & Emma</td>
                  <td>$1,800</td>
                  <td><span class="os3-badge os3-badge-green">Paid</span></td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Screen 6: Reports -->
        <div class="os3-screen" id="screen-reports">
          <div class="os3-screen-header">
            <h3>Financial Overview</h3>
            <div class="os3-period-selector">This Month ▾</div>
          </div>
          <div class="os3-stat-cards" style="margin-bottom: 20px;">
            <div class="os3-stat">
              <span class="os3-stat-label">Total Revenue</span>
              <span class="os3-stat-val">$18,420</span>
              <span class="os3-stat-change os3-green">+18.4%</span>
            </div>
            <div class="os3-stat">
              <span class="os3-stat-label">Profit</span>
              <span class="os3-stat-val">$11,280</span>
              <span class="os3-stat-change os3-green">+14.2%</span>
            </div>
            <div class="os3-stat">
              <span class="os3-stat-label">Billable Hours</span>
              <span class="os3-stat-val">124h</span>
              <span class="os3-stat-change os3-green">+8.6%</span>
            </div>
          </div>
          <div class="os3-chart-placeholder">
            <svg viewBox="0 0 400 150" preserveAspectRatio="none" style="width:100%; height:100%;">
              <defs>
                <linearGradient id="chartGrad" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#3F7FF5" stop-opacity="0.3" />
                  <stop offset="100%" stop-color="#3F7FF5" stop-opacity="0" />
                </linearGradient>
              </defs>
              <path d="M0,150 L0,100 Q50,120 100,80 T200,60 T300,40 T400,20 L400,150 Z" fill="url(#chartGrad)"></path>
              <path d="M0,100 Q50,120 100,80 T200,60 T300,40 T400,20" fill="none" stroke="#3F7FF5" stroke-width="3"></path>
            </svg>
          </div>
        </div>

      </div>
    </div>

    <div class="os3-benefits">
      <div class="os3-benefit-item"><span class="os3-check">&check;</span> Unlimited clients</div>
      <div class="os3-benefit-item"><span class="os3-check">&check;</span> Unlimited projects</div>
      <div class="os3-benefit-item"><span class="os3-check">&check;</span> Track your time</div>
      <div class="os3-benefit-item"><span class="os3-check">&check;</span> Invoice & get paid</div>
      <div class="os3-benefit-item"><span class="os3-check">&check;</span> Understand profitability</div>
    </div>
  </div>
</section>

<style>
  .os3-section {
    padding: 110px 20px;
    background: #f8faff;
    font-family: system-ui, -apple-system, sans-serif;
  }
  .os3-container {
    width: min(1200px, calc(100% - 48px));
    margin: 0 auto;
  }
  .os3-header {
    text-align: center;
    margin-bottom: 60px;
  }
  .os3-eyebrow {
    display: inline-block;
    padding: 6px 14px;
    background: #eef1f5;
    color: #475467;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    margin-bottom: 16px;
  }
  .os3-header h2 {
    font-size: 42px;
    font-weight: 800;
    color: #101828;
    line-height: 1.1;
    margin: 0 0 16px;
  }
  .os3-header h2 span {
    color: #3F7FF5;
  }
  .os3-subtitle {
    font-size: 18px;
    color: #475467;
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.5;
  }

  .os3-showcase {
    display: grid;
    grid-template-columns: 310px minmax(0, 1fr);
    min-height: 600px;
    border-radius: 24px;
    border: 1px solid #e1e8f2;
    background: #fff;
    box-shadow: 0 25px 70px rgba(16,24,40,.08);
    overflow: hidden;
  }

  .os3-tabs {
    background: #f7f9fc;
    border-right: 1px solid #e8ecf2;
    padding: 28px 0;
  }
  .os3-tabs-heading {
    padding: 0 22px;
    margin-bottom: 18px;
    color: #98a2b3;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .1em;
  }
  .os3-tab {
    padding: 13px 22px;
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    transition: 0.2s;
    position: relative;
  }
  .os3-tab-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    background: #eef1f5;
    color: #667085;
    transition: 0.2s;
    flex-shrink: 0;
  }
  .os3-tab-content h4 {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    color: #101828;
    transition: 0.2s;
  }
  .os3-tab-content p {
    margin: 2px 0 0;
    font-size: 10px;
    color: #98a2b3;
    transition: 0.2s;
  }
  .os3-progress {
    height: 2px;
    background: #eef1f5;
    margin-top: 8px;
    border-radius: 2px;
    overflow: hidden;
    opacity: 0;
    transition: 0.2s;
  }
  .os3-progress i {
    display: block;
    height: 100%;
    background: #3F7FF5;
    width: 0%;
  }

  .os3-tab.os3-active {
    background: transparent;
  }
  .os3-tab.os3-active .os3-tab-icon {
    background: linear-gradient(135deg, #65a7ff, #315fe7);
    color: #fff;
    box-shadow: 0 4px 12px rgba(63,127,245,.20);
  }
  .os3-tab.os3-active .os3-progress {
    opacity: 1;
  }
  .os3-tab.os3-active .os3-tab-content h4 {
    color: #3F7FF5;
  }

  .os3-interface-area {
    padding: 30px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    background: #fff;
  }
  .os3-screen {
    display: none;
    flex: 1;
    animation: fadeIn 0.4s ease-out;
  }
  .os3-screen.os3-active-screen {
    display: block;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .os3-screen-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid #f1f5f9;
  }
  .os3-screen-header h3 {
    margin: 0;
    font-size: 18px;
    color: #101828;
    font-weight: 700;
  }
  .os3-search-bar {
    padding: 8px 16px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    color: #94a3b8;
    font-size: 14px;
    width: 200px;
  }
  .os3-btn {
    display: inline-block;
    padding: 8px 16px;
    background: #3F7FF5;
    color: #fff;
    border-radius: 8px;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    transition: background 0.2s;
  }
  .os3-btn:hover {
    background: #315fe7;
  }
  .os3-btn-start {
    background: #12B76A;
  }
  .os3-btn-start:hover {
    background: #039855;
  }

  .os3-table-wrapper {
    background: #fff;
    border: 1px solid #f1f5f9;
    border-radius: 12px;
    overflow: hidden;
  }
  .os3-table {
    width: 100%;
    border-collapse: collapse;
  }
  .os3-table td {
    padding: 16px;
    border-bottom: 1px solid #f1f5f9;
    font-size: 14px;
    color: #475467;
    vertical-align: middle;
  }
  .os3-table tr:last-child td {
    border-bottom: none;
  }
  .os3-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 700;
  }
  .os3-name {
    font-weight: 600;
    color: #101828;
  }
  .os3-badge {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 600;
  }
  .os3-badge-green { background: #dcfce7; color: #166534; }
  .os3-badge-blue { background: #e0f2fe; color: #0284c7; }
  .os3-badge-yellow { background: #fef9c3; color: #854d0e; }
  .os3-badge-red { background: #fee2e2; color: #991b1b; }

  .os3-screen-footer {
    text-align: center;
    margin-top: 20px;
    font-size: 13px;
    color: #64748b;
  }

  .os3-grid-2x2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .os3-card {
    background: #f8fafc;
    border: 1px solid #f1f5f9;
    border-radius: 16px;
    padding: 20px;
  }
  .os3-card-top {
    display: flex;
    justify-content: space-between;
    margin-bottom: 12px;
    font-size: 12px;
  }
  .os3-card-client { color: #64748b; font-weight: 600; }
  .os3-card-due { color: #94a3b8; }
  .os3-card-title {
    margin: 0 0 16px;
    font-size: 16px;
    color: #101828;
  }
  .os3-card-progress {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .os3-progress-bar {
    flex: 1;
    height: 6px;
    background: #e2e8f0;
    border-radius: 3px;
    overflow: hidden;
  }
  .os3-progress-fill {
    height: 100%;
    border-radius: 3px;
  }
  .os3-progress-text {
    font-size: 12px;
    font-weight: 600;
    color: #475467;
  }

  .os3-stat-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .os3-stat {
    padding: 20px;
    background: #f8fafc;
    border-radius: 16px;
    border: 1px solid #f1f5f9;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .os3-stat-label { font-size: 13px; color: #64748b; }
  .os3-stat-val { font-size: 24px; font-weight: 700; color: #101828; }
  .os3-stat-change, .os3-stat-sub { font-size: 12px; font-weight: 600; }
  .os3-green { color: #12B76A; }

  .os3-doc-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .os3-doc-item {
    display: flex;
    align-items: center;
    padding: 16px;
    background: #f8fafc;

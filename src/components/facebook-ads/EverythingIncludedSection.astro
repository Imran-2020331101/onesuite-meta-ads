<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.os3-tab');
    const screens = document.querySelectorAll('.os3-screen');
    let currentIndex = 0;
    let autoplayInterval;
    let progressAnimation;
    const AUTOPLAY_DURATION = 4500; // 4.5s
    const IDLE_DURATION = 10000; // 10s
    let idleTimeout;

    function switchTab(index, animate = true) {
      tabs.forEach(t => {
        t.classList.remove('os3-active');
        const progress = t.querySelector('.os3-progress i');
        if (progress) {
          progress.style.transition = 'none';
          progress.style.width = '0%';
        }
      });
      screens.forEach(s => s.classList.remove('os3-active-screen'));

      currentIndex = index;
      const tab = tabs[currentIndex];
      tab.classList.add('os3-active');
      const tabId = tab.getAttribute('data-tab');
      const targetScreen = document.getElementById(`screen-${tabId}`);
      if (targetScreen) targetScreen.classList.add('os3-active-screen');

      if (animate) {
        const activeProgress = tab.querySelector('.os3-progress i');
        if (activeProgress) {
          // Force reflow
          void activeProgress.offsetWidth;
          activeProgress.style.transition = `width ${AUTOPLAY_DURATION}ms linear`;
          activeProgress.style.width = '100%';
        }
      } else {
         const activeProgress = tab.querySelector('.os3-progress i');
         if(activeProgress) {
            activeProgress.style.transition = 'none';
            activeProgress.style.width = '100%';
         }
      }
    }

    function startAutoplay() {
      clearInterval(autoplayInterval);
      switchTab(currentIndex, true);
      autoplayInterval = setInterval(() => {
        let nextIndex = (currentIndex + 1) % tabs.length;
        switchTab(nextIndex, true);
      }, AUTOPLAY_DURATION);
    }

    function resetIdleTimer() {
      clearTimeout(idleTimeout);
      clearInterval(autoplayInterval);
      
      // Complete progress of current tab instantly since user clicked
      tabs.forEach(t => {
          const progress = t.querySelector('.os3-progress i');
          if(progress) {
             progress.style.transition = 'none';
          }
      });

      idleTimeout = setTimeout(() => {
        startAutoplay();
      }, IDLE_DURATION);
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => {
        switchTab(index, false); // No animation on manual click
        resetIdleTimer();
      });
    });

    // Initialize
    startAutoplay();
  });
</script>

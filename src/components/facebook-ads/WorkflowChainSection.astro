---
// WorkflowChainSection.astro
---

<section class="os-workflow-section">
  <div class="os-container">
    <div class="os-workflow-header">
      <div class="os-eyebrow">YOUR CLIENT WORKFLOW</div>
      <h2>From New Lead<br /><span>to Happy Client.</span></h2>
      <p>
        Keep the entire client journey organised from the moment someone
        contacts you to the moment the project is completed and paid.
      </p>
    </div>

    <div class="os-workflow-chain-wrapper">
      <div class="os-workflow-line"></div>

      <div class="os-workflow-grid">
        <!-- Step 1 -->
        <div class="os-workflow-card">
          <div class="os-step-number">STEP 01</div>
          <div class="os-icon-circle">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><line x1="12" y1="5" x2="12" y2="19"></line><line
                x1="5"
                y1="12"
                x2="19"
                y2="12"></line></svg
            >
          </div>
          <h3>Capture the Client</h3>
          <p>
            Add a new lead or client and keep their information organised from
            the beginning.
          </p>
          <div class="os-badge">New Client ✓</div>
        </div>

        <!-- Step 2 -->
        <div class="os-workflow-card">
          <div class="os-step-number">STEP 02</div>
          <div class="os-icon-circle">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><rect x="3" y="3" width="7" height="7"></rect><rect
                x="14"
                y="3"
                width="7"
                height="7"></rect><rect x="14" y="14" width="7" height="7"
              ></rect><rect x="3" y="14" width="7" height="7"></rect></svg
            >
          </div>
          <h3>Create the Project</h3>
          <p>
            Turn the client into a project, add tasks, deadlines and keep
            everyone clear on what's happening.
          </p>
          <div class="os-badge">Project Created ✓</div>
        </div>

        <!-- Step 3 -->
        <div class="os-workflow-card">
          <div class="os-step-number">STEP 03</div>
          <div class="os-icon-circle">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path
                d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
              ></path><polyline points="14 2 14 8 20 8"></polyline><line
                x1="16"
                y1="13"
                x2="8"
                y2="13"></line><line x1="16" y1="17" x2="8" y2="17"
              ></line><polyline points="10 9 9 9 8 9"></polyline></svg
            >
          </div>
          <h3>Send the Contract</h3>
          <p>
            Send your agreement for signing and keep important documents
            connected to the client.
          </p>
          <div class="os-badge">Contract Signed ✓</div>
        </div>

        <!-- Step 4 -->
        <div class="os-workflow-card">
          <div class="os-step-number">STEP 04</div>
          <div class="os-icon-circle">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><line x1="12" y1="1" x2="12" y2="23"></line><path
                d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"
              ></path></svg
            >
          </div>
          <h3>Invoice & Get Paid</h3>
          <p>
            Send professional invoices and make it easier for clients to
            complete their payments.
          </p>
          <div class="os-badge">Payment Received ✓</div>
        </div>
      </div>
    </div>

    <div class="os-workflow-bottom">
      <strong
        >Less admin. Fewer tools. <span>More time for your actual work.</span
        ></strong
      >
    </div>
  </div>
</section>

<style>
  .os-workflow-section {
    background-color: #f8faff;
    padding: 110px 20px;
    font-family:
      system-ui,
      -apple-system,
      sans-serif;
  }

  .os-container {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  .os-workflow-header {
    text-align: center;
    margin-bottom: 70px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .os-eyebrow {
    display: inline-flex;
    padding: 7px 14px;
    border-radius: 999px;
    background-color: #f1f5ff;
    border: 1px solid var(--os-orange);
    color: var(--os-orange);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.14em;
    margin-bottom: 24px;
    text-transform: uppercase;
  }

  .os-workflow-header h2 {
    font-size: clamp(38px, 5vw, 56px);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1.04;
    color: #101828;
    margin: 0 0 20px 0;
  }

  .os-workflow-header h2 span {
    color: #3f7ff5;
  }

  .os-workflow-header p {
    max-width: 620px;
    color: #667085;
    font-size: 17px;
    line-height: 1.7;
    margin: 0;
  }

  .os-workflow-chain-wrapper {
    position: relative;
  }

  .os-workflow-line {
    position: absolute;
    top: 66px;
    left: 10%;
    right: 10%;
    height: 2px;
    background-color: #dce5f5;
    z-index: 1;
  }

  .os-workflow-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    position: relative;
    z-index: 2;
  }

  .os-workflow-card {
    background-color: #ffffff;
    border: 1px solid #e4eaf3;
    border-radius: 16px;
    padding: 28px 22px;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .os-workflow-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 45px rgba(63, 127, 245, 0.1);
  }

  .os-step-number {
    font-size: 10px;
    color: #98a2b3;
    font-weight: 800;
    letter-spacing: 0.1em;
    margin-bottom: 16px;
  }

  .os-icon-circle {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: linear-gradient(135deg, #65a7ff, #315fe7);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    margin-bottom: 20px;
    flex-shrink: 0;
  }

  .os-workflow-card h3 {
    font-size: 18px;
    font-weight: 700;
    color: #101828;
    margin: 0 0 12px 0;
    line-height: 1.3;
  }

  .os-workflow-card p {
    font-size: 14px;
    color: #475467;
    line-height: 1.6;
    margin: 0 0 20px 0;
    flex-grow: 1;
  }

  .os-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 10px;
    border-radius: 7px;
    background-color: #ecfdf3;
    color: #039855;
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .os-workflow-bottom {
    border: 2px solid var(--os-orange-light);
    border-radius: 20px;
    background-color: var(--os-orange-light);
    padding: 12px 0 12px 0;
    text-align: center;
    margin-top: 50px;
  }

  .os-workflow-bottom strong {
    font-size: 20px;
    color: #101828;
    font-weight: 700;
  }

  .os-workflow-bottom span {
    color: #ffffff;
  }

  @media (max-width: 900px) {
    .os-workflow-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .os-workflow-line {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .os-workflow-grid {
      grid-template-columns: 1fr;
    }
    .os-workflow-section {
      padding: 70px 20px;
    }
  }
</style>

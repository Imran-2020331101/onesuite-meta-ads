---
interface Props {
  title?: string;
  description?: string;
  buttonOneText?: string;
}

const {
  title = "Turn your team's time into profitable work.",
  description = "Track time. Manage projects. Serve clients. Send invoices. Get paid — all from one workspace.",
  buttonOneText = "Start your free trial"
} = Astro.props;
---
<section class="os-product-strip">
  <div class="os-strip-container">
    <h2>{title}</h2>
    <p>{description}</p>
    <a href="https://app.onesuite.io" class="os-strip-btn">{buttonOneText} &rarr;</a>
    <div class="os-strip-small">No credit card required</div>
  </div>
</section>

<style>
  .os-product-strip {
    padding: 80px 20px;
    background: linear-gradient(135deg, #3F7FF5, #2961e0);
    text-align: center;
  }
  .os-strip-container {
    max-width: 700px;
    margin: 0 auto;
  }
  .os-strip-container h2 {
    color: white;
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0;
  }
  .os-strip-container p {
    color: rgba(255, 255, 255, 0.8);
    font-size: 16px;
    line-height: 1.7;
    margin-top: 16px;
    margin-bottom: 0;
  }
  .os-strip-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 28px;
    min-height: 52px;
    padding: 0 28px;
    background: white;
    color: #3F7FF5;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 750;
    box-shadow: 0 8px 24px rgba(0,0,0,0.15);
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .os-strip-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.20);
  }
  .os-strip-small {
    color: rgba(255, 255, 255, 0.6);
    font-size: 11px;
    margin-top: 10px;
  }
</style>
